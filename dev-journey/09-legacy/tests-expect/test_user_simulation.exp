#!/usr/bin/expect -f
# Simula um usuário real pedindo para ler, criar e corrigir código

set timeout 300

set fd [open "/home/andrefarias/Desenvolvimento/Nyx-Code/.env" r]
while {[gets $fd line] >= 0} {
    if {[regexp {^([A-Z_]+)=(.*)$} $line -> key val]} {
        set env($key) $val
    }
}
close $fd

set env(CLAUDE_CODE_USE_OPENAI) 1
set env(OPENAI_API_KEY) ollama
set env(OPENAI_BASE_URL) "http://127.0.0.1:11435/v1"
set env(OPENAI_MODEL) "qwen3:4b"
set env(OPENAI_TIMEOUT) 300000

# Subir Ollama com GPU limitada
system "cd /home/andrefarias/Desenvolvimento/Nyx-Code && OLLAMA_HOST=127.0.0.1:11435 OLLAMA_MODELS=\$(pwd)/models /usr/local/bin/ollama serve > logs/ollama.log 2>&1 &"
sleep 3
# Warmup
system "curl -sf --max-time 120 http://127.0.0.1:11435/api/chat -H 'Content-Type: application/json' -d '{\"model\":\"qwen3:4b\",\"messages\":\[{\"role\":\"user\",\"content\":\"hi\"}\],\"stream\":false,\"options\":{\"num_gpu\":20}}' > /dev/null 2>&1"

log_file -noappend /tmp/nyx_user_sim.log

spawn node /home/andrefarias/Desenvolvimento/Nyx-Code/bin/nyx --thinking disabled --model qwen3:4b --dangerously-skip-permissions

expect {
    "Ready" { send_user "\n>>> INTERFACE OK <<<\n" }
    timeout { send_user "\n>>> INTERFACE FALHOU <<<\n"; exit 1 }
}
sleep 3

# ============================================================
# TESTE 1: Ler um arquivo existente
# ============================================================
send_user "\n>>> TESTE 1: Ler main.py <<<\n"
send "leia o arquivo main.py e me diga quantas linhas tem\r"

expect {
    -re "main\\.py|linhas|lines|def main|argparse|logging" {
        send_user "\n>>> TESTE 1: PASSOU <<<\n"
    }
    -re "Error|error|fetch failed|not found" {
        send_user "\n>>> TESTE 1: FALHOU (erro) <<<\n"
    }
    timeout {
        send_user "\n>>> TESTE 1: TIMEOUT <<<\n"
    }
}
sleep 5

# ============================================================
# TESTE 2: Criar um arquivo novo
# ============================================================
send_user "\n>>> TESTE 2: Criar hello.py <<<\n"
send "crie o arquivo /tmp/nyx_hello.py com uma funcao que imprime 'Nyx funciona' e um if __name__ == '__main__' que chama ela\r"

expect {
    -re "cri|escrev|wrote|created|hello|nyx_hello" {
        send_user "\n>>> TESTE 2: PASSOU (modelo respondeu) <<<\n"
    }
    -re "Error|error|fetch failed" {
        send_user "\n>>> TESTE 2: FALHOU (erro) <<<\n"
    }
    timeout {
        send_user "\n>>> TESTE 2: TIMEOUT <<<\n"
    }
}
sleep 5

# ============================================================
# TESTE 3: Executar o arquivo criado
# ============================================================
send_user "\n>>> TESTE 3: Executar hello.py <<<\n"
send "execute python3 /tmp/nyx_hello.py\r"

expect {
    -re "Nyx funciona|funciona|executed|output|ran|hello" {
        send_user "\n>>> TESTE 3: PASSOU <<<\n"
    }
    -re "Error|error|No such file|not found" {
        send_user "\n>>> TESTE 3: FALHOU <<<\n"
    }
    timeout {
        send_user "\n>>> TESTE 3: TIMEOUT <<<\n"
    }
}
sleep 5

# ============================================================
# TESTE 4: Buscar texto no projeto
# ============================================================
send_user "\n>>> TESTE 4: Buscar 'Ollama' no projeto <<<\n"
send "busque a palavra Ollama nos arquivos deste projeto\r"

expect {
    -re "Ollama|match|result|run\\.sh|install\\.sh|README" {
        send_user "\n>>> TESTE 4: PASSOU <<<\n"
    }
    -re "Error|error|fetch failed" {
        send_user "\n>>> TESTE 4: FALHOU <<<\n"
    }
    timeout {
        send_user "\n>>> TESTE 4: TIMEOUT <<<\n"
    }
}
sleep 5

# ============================================================
# TESTE 5: Listar arquivos
# ============================================================
send_user "\n>>> TESTE 5: Listar arquivos .sh <<<\n"
send "liste todos os arquivos .sh deste projeto\r"

expect {
    -re "install\\.sh|run\\.sh|uninstall\\.sh|\\.sh" {
        send_user "\n>>> TESTE 5: PASSOU <<<\n"
    }
    -re "Error|error|fetch failed" {
        send_user "\n>>> TESTE 5: FALHOU <<<\n"
    }
    timeout {
        send_user "\n>>> TESTE 5: TIMEOUT <<<\n"
    }
}
sleep 5

# ============================================================
# TESTE 6: Git diff
# ============================================================
send_user "\n>>> TESTE 6: /diff <<<\n"
send "/diff\r"
sleep 8
expect {
    -re "diff|changed|untracked|Diff|file" {
        send_user "\n>>> TESTE 6: PASSOU <<<\n"
    }
    -re "Error|Unknown" {
        send_user "\n>>> TESTE 6: FALHOU <<<\n"
    }
    timeout {
        send_user "\n>>> TESTE 6: TIMEOUT <<<\n"
    }
}
send "\033"
sleep 2

# ============================================================
# TESTE 7: /status
# ============================================================
send_user "\n>>> TESTE 7: /status <<<\n"
send "/status\r"
sleep 8
expect {
    -re "qwen3|Local|OpenAI|provider|Model|status|Status" {
        send_user "\n>>> TESTE 7: PASSOU <<<\n"
    }
    -re "Error|Unknown" {
        send_user "\n>>> TESTE 7: FALHOU <<<\n"
    }
    timeout {
        send_user "\n>>> TESTE 7: TIMEOUT <<<\n"
    }
}
send "\033"
sleep 2

# ============================================================
# SAIR
# ============================================================
send "/exit\r"
sleep 2
send_user "\n>>> TODOS OS TESTES CONCLUIDOS <<<\n"

# Parar Ollama
system "pkill -f 'ollama serve' 2>/dev/null"
