#!/usr/bin/expect -f
set timeout 180

set fd [open "/home/andrefarias/Desenvolvimento/Nyx-Code/.env" r]
while {[gets $fd line] >= 0} {
    if {[regexp {^([A-Z_]+)=(.*)$} $line -> key val]} {
        set env($key) $val
    }
}
close $fd

set env(CLAUDE_CODE_USE_OPENAI) 1
set env(OPENAI_API_KEY) ollama
set env(OPENAI_BASE_URL) "http://127.0.0.1:11435/v1"
set env(OPENAI_MODEL) "qwen3:4b"
set env(OPENAI_TIMEOUT) 300000

log_file -noappend /tmp/nyx_tools_test.log

spawn node /home/andrefarias/Desenvolvimento/Nyx-Code/bin/openclaude --thinking disabled --model qwen3:4b --dangerously-skip-permissions

expect "Ready"
sleep 3

send_user "\n=== TESTE TOOL: Bash(ls) ===\n"
send "execute o comando: ls README.md\r"

# Aguardar resposta do modelo (pode demorar 2-3min)
expect {
    -re "README" { send_user "\n=== BASH OK: Viu README.md ===\n" }
    -re "Error|error|fetch failed" { send_user "\n=== BASH ERRO ===\n" }
    timeout { send_user "\n=== BASH TIMEOUT ===\n" }
}

sleep 5
send "/exit\r"
sleep 2
send_user "\n=== TESTE CONCLUIDO ===\n"
