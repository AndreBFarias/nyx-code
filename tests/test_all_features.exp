#!/usr/bin/expect -f
set timeout 180

set fd [open "/home/andrefarias/Desenvolvimento/Nyx-Code/.env" r]
while {[gets $fd line] >= 0} {
    if {[regexp {^([A-Z_]+)=(.*)$} $line -> key val]} {
        set env($key) $val
    }
}
close $fd

set env(CLAUDE_CODE_USE_OPENAI) 1
set env(OPENAI_API_KEY) ollama
set env(OPENAI_BASE_URL) "http://127.0.0.1:11435/v1"
set env(OPENAI_MODEL) "qwen3:4b"
set env(OPENAI_TIMEOUT) 300000

log_file -noappend /tmp/nyx_all_features.log

spawn node /home/andrefarias/Desenvolvimento/Nyx-Code/bin/openclaude --thinking disabled --model qwen3:4b --dangerously-skip-permissions

expect "Ready"
sleep 3

# --- TOOL: Read ---
send_user "\n### TOOL_READ ###\n"
send "use a tool Read para ler o arquivo CLAUDE.md\r"
expect {
    -re "Nyx|agente|codigo|PT-BR" { send_user "\nREAD_OK\n" }
    -re "Error|error|fetch" { send_user "\nREAD_ERRO\n" }
    timeout { send_user "\nREAD_TIMEOUT\n" }
}
sleep 3

# --- TOOL: Glob ---
send_user "\n### TOOL_GLOB ###\n"
send "use Glob para listar todos os arquivos .md neste projeto\r"
expect {
    -re "README|CLAUDE|sprint" { send_user "\nGLOB_OK\n" }
    -re "Error|error|fetch" { send_user "\nGLOB_ERRO\n" }
    timeout { send_user "\nGLOB_TIMEOUT\n" }
}
sleep 3

# --- TOOL: Grep ---
send_user "\n### TOOL_GREP ###\n"
send "use Grep para buscar a palavra Nyx nos arquivos deste projeto\r"
expect {
    -re "Nyx|match|result|CLAUDE" { send_user "\nGREP_OK\n" }
    -re "Error|error|fetch" { send_user "\nGREP_ERRO\n" }
    timeout { send_user "\nGREP_TIMEOUT\n" }
}
sleep 3

# --- TOOL: Write ---
send_user "\n### TOOL_WRITE ###\n"
send "crie um arquivo /tmp/nyx_test_write.txt com o conteudo: Nyx funciona\r"
expect {
    -re "cri|escr|wrote|created|Write" { send_user "\nWRITE_OK\n" }
    -re "Error|error|fetch" { send_user "\nWRITE_ERRO\n" }
    timeout { send_user "\nWRITE_TIMEOUT\n" }
}
sleep 3

# --- TOOL: Edit ---
send_user "\n### TOOL_EDIT ###\n"
send "edite o arquivo /tmp/nyx_test_write.txt e troque 'funciona' por 'funciona perfeitamente'\r"
expect {
    -re "edit|modif|alterou|Edit|perfeitamente" { send_user "\nEDIT_OK\n" }
    -re "Error|error|fetch" { send_user "\nEDIT_ERRO\n" }
    timeout { send_user "\nEDIT_TIMEOUT\n" }
}
sleep 3

# --- SLASH: /commit (sem mudancas staged) ---
send_user "\n### SLASH_COMMIT ###\n"
send "/commit\r"
sleep 8
expect {
    -re "commit|changes|nothing|No changes|diff" { send_user "\nCOMMIT_OK\n" }
    -re "Error|Unknown" { send_user "\nCOMMIT_ERRO\n" }
    timeout { send_user "\nCOMMIT_TIMEOUT\n" }
}
send "\033"
sleep 2

# --- SLASH: /review ---
send_user "\n### SLASH_REVIEW ###\n"
send "/review\r"
sleep 5
expect {
    -re "review|Review|PR|pull" { send_user "\nREVIEW_OK\n" }
    -re "Error|Unknown" { send_user "\nREVIEW_ERRO\n" }
    timeout { send_user "\nREVIEW_TIMEOUT\n" }
}
send "\033"
sleep 2

