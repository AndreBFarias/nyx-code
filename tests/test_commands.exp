#!/usr/bin/expect -f
set timeout 30

set fd [open "/home/andrefarias/Desenvolvimento/Nyx-Code/.env" r]
while {[gets $fd line] >= 0} {
    if {[regexp {^([A-Z_]+)=(.*)$} $line -> key val]} {
        set env($key) $val
    }
}
close $fd

set env(CLAUDE_CODE_USE_OPENAI) 1
set env(OPENAI_API_KEY) ollama
set env(OPENAI_BASE_URL) "http://127.0.0.1:11435/v1"
set env(OPENAI_MODEL) "qwen3:4b"
set env(OPENAI_TIMEOUT) 300000

set logfile [open "/tmp/nyx_e2e_results.txt" w]

proc test_cmd {name cmd logfile} {
    puts $logfile "=== $name ==="
    send "$cmd\r"
    sleep 8
    # Capturar tudo no buffer
    expect {
        -re "(.+)" {
            puts $logfile $expect_out(buffer)
        }
        timeout {}
    }
    # Esc para fechar paineis
    send "\033"
    sleep 2
    puts $logfile "=== FIM $name ==="
    puts $logfile ""
}

spawn node /home/andrefarias/Desenvolvimento/Nyx-Code/bin/openclaude --thinking disabled --model qwen3:4b --dangerously-skip-permissions

expect {
    "Ready" {}
    timeout { puts $logfile "ERRO: Interface nao carregou"; exit 1 }
}
sleep 3
puts $logfile "INTERFACE OK"

test_cmd "/help" "/help" $logfile
test_cmd "/status" "/status" $logfile
test_cmd "/config" "/config" $logfile
test_cmd "/model" "/model" $logfile
test_cmd "/diff" "/diff" $logfile
test_cmd "/doctor" "/doctor" $logfile
test_cmd "/compact" "/compact" $logfile
test_cmd "/cost" "/cost" $logfile
test_cmd "/memory" "/memory" $logfile
test_cmd "/vim" "/vim" $logfile
test_cmd "/theme" "/theme" $logfile
test_cmd "/clear" "/clear" $logfile

send "/exit\r"
sleep 2

close $logfile
