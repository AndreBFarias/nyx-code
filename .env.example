# Nyx-Code - Configuração
# Copie para .env e ajuste conforme necessário

# Ollama dedicado
NYX_OLLAMA_PORT=11435
NYX_OLLAMA_HOST=127.0.0.1

# Modelo padrão (qwen3:4b, qwen2.5-coder:3b ou qwen2.5-coder:7b)
# qwen3:4b = suporte nativo a tool calling (recomendado)
# qwen2.5-coder:3b/7b = sem tool calling real (só chat)
NYX_MODEL=qwen3:4b

# Limite de VRAM em GB (para modelo 7b)
NYX_VRAM_MAX=2.5

# Debug (0 ou 1)
NYX_DEBUG=0

# Timeouts (segundos)
NYX_CURL_TIMEOUT=10
NYX_OLLAMA_START_TIMEOUT=30

# Máximo de iterações do agente
NYX_MAX_ITERATIONS=50

# Temperatura do modelo
NYX_TEMPERATURE=0.3
