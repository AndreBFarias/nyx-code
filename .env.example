# Nyx-Code - Configuração
# Copie para .env e ajuste conforme necessário

# Ollama
NYX_OLLAMA_PORT=11435
NYX_OLLAMA_HOST=127.0.0.1

# Proxy (converte /v1/ para API nativa com think=false)
NYX_PROXY_PORT=11436

# Modelo padrão (qwen2.5-coder:3b — non-thinking, PT-BR 100%, tool calling, P50 1.15s)
# Decisão: ADR-031. Para legacy qwen3:4b, use ./run.sh --4b ou NYX_MODEL=qwen3:4b.
NYX_MODEL=qwen2.5-coder:3b

# Auto-tune de GPU (1=detecta VRAM e calcula num_gpu automaticamente)
# Quando 0, usa NYX_NUM_GPU abaixo literal (útil pra fixar valor conservador)
NYX_AUTO_TUNE=1

# GPU (layers na GPU — menor = menos VRAM, mais CPU)
# Ignorado se NYX_AUTO_TUNE=1. Fallback em máquinas sem venv.
# RTX 3050 (4GB): 12. RTX 4060 (8GB): ~36 pra qwen2.5-coder:3b. CPU-only: 0
NYX_NUM_GPU=12
NYX_NUM_CTX=4096

# Quantização do KV cache (INFRA-KVCACHE-QUANT-01, ADR-032): q8_0 corta ~metade
# da VRAM do cache (perda de qualidade negligenciável) e ajuda o modelo caber em
# 4GB com o desktop cheio. Requer flash attention (o run.sh já liga). f16 = sem
# quantização (mais VRAM); q4_0 = mais agressivo. Default q8_0.
NYX_KV_CACHE_TYPE=q8_0

# Reanimação de GPU pós-OOM (INFRA-OOM-ADAPTIVE-GPU-01, ADR-032/033): 1 = quando
# a sessão cai para CPU por OOM e a VRAM liberar depois (ex.: você fechou o
# Chrome), o Nyx VOLTA para a GPU automaticamente, sem reiniciar (cooldown anti-
# loop; NÃO sobe o cap de boot -- a fragmentação CUDA limita o teto). 0 = fica em
# CPU até reiniciar (default conservador, comportamento estabilizado). EXPERIMENTAL:
# ligue, use de verdade e observe `grep "Degradando num_gpu=0" logs/proxy.log`.
NYX_GPU_ADAPTIVE=0

# VRAM máximo em GB (referência)
NYX_VRAM_MAX=2.5

# Temperatura do modelo
NYX_TEMPERATURE=0.3

# Debug (0 ou 1)
NYX_DEBUG=0

# Timeouts
NYX_CURL_TIMEOUT=10
NYX_OLLAMA_START_TIMEOUT=30
NYX_MAX_ITERATIONS=50

# Auth da TUI (não usada para API — tudo vai pro Ollama via proxy)
# A chave ANTHROPIC_API_KEY foi movida para ~/.config/nyx/secrets (chmod 600).
# Edite esse arquivo após o primeiro install (gerado por install.sh):
#   ANTHROPIC_API_KEY=sk-ant-...
# A precedência é: secrets > .env (secrets sobrescreve).
