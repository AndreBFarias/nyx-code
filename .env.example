# Nyx-Code - Configuração
# Copie para .env e ajuste conforme necessário

# Ollama
NYX_OLLAMA_PORT=11435
NYX_OLLAMA_HOST=127.0.0.1

# Proxy (converte /v1/ para API nativa com think=false)
NYX_PROXY_PORT=11436

# Modelo padrão (qwen3:4b recomendado — suporte a tool calling)
NYX_MODEL=qwen3:4b

# GPU (layers na GPU — menor = menos VRAM, mais CPU)
# RTX 3050 (4GB): usar 12. GPU maior: usar 20+
NYX_NUM_GPU=12
NYX_NUM_CTX=4096

# VRAM máximo em GB (referência)
NYX_VRAM_MAX=2.5

# Temperatura do modelo
NYX_TEMPERATURE=0.3

# Debug (0 ou 1)
NYX_DEBUG=0

# Timeouts
NYX_CURL_TIMEOUT=10
NYX_OLLAMA_START_TIMEOUT=30
NYX_MAX_ITERATIONS=50

# Auth da TUI (não usada para API — tudo vai pro Ollama via proxy)
# ANTHROPIC_API_KEY=sk-ant-...
