/* Nyx-Code TUI styles -- ONDA-32 LUNA-ADOPT.
 *
 * Paleta canonica (ADR-023): turquesa #00D4AA + roxo #9D4EDD + verde #4ADE80.
 * Template estrutural derivado de Luna templo_de_nyx.css (2 colunas adaptado
 * para 1 coluna), mantendo identidade visual Nyx.
 *
 * Sub-sprints filhas da ONDA-32 consomem estes blocos:
 *   - TUI-BANNER-DOCK-TOP-01      -> BannerWidget (dock: top)
 *   - TUI-CHATMESSAGE-WIDGET-01   -> ChatMessage.{user,assistant,tool,system}
 *   - TUI-VERTICAL-SCROLL-ADOPT-01-> #chat (VerticalScroll com scrollbar-*)
 *   - TUI-DEFAULT-FLIP-LEGACY-RM-01 -> deletou OutputWidget legacy
 */

/* ---------- Tokens canonicos (paridade ADR-023 / design_tokens.py) ---------- */

$accent: #00D4AA;        /* turquesa NYX_ACCENT  -- accent principal */
$primary: #9D4EDD;       /* roxo NYX_PURPLE      -- assistente, bypass, memoria */
$success: #4ADE80;       /* verde NYX_SUCCESS    -- tool ok */
$error: #EF4444;         /* vermelho NYX_ERROR   -- tool fail */
$muted: #6B7280;         /* cinza NYX_MUTED      -- toolbar, system, tool */
$surface: #0A0E14;       /* fundo escuro         -- base do tema */
$foreground: #E6E4D9;    /* texto claro          -- corpo de mensagens */

/* ---------- Telas raiz ---------- */

Screen {
    background: $surface;
    color: $foreground;
}

App {
    background: $surface;
}

/* ---------- BannerWidget (rolável, 1o filho do #chat) ---------- */
/* TUI-BANNER-DOCK-TOP-01 ancorava no topo (dock:top). TUI-BANNER-SCROLLABLE-01
 * removeu o dock: o banner agora é o 1o filho do #chat e rola junto com a
 * conversa. Cursor blink local via BannerWidget.refresh() (sem race global). */

BannerWidget {
    height: auto;
    background: $surface;
    padding: 0 1;
    color: $accent;
}

/* ---------- #chat (VerticalScroll com scrollbar canonica) ---------- */
/* Sub-sprint TUI-VERTICAL-SCROLL-ADOPT-01 consome height 1fr + scrollbar
 * tematizada. Paleta scrollbar segue Luna: primary dim repouso, primary cheio
 * hover, accent destacado em drag. */

#chat {
    height: 1fr;
    background: $surface;
    padding: 1 1;
    scrollbar-background: $surface;
    scrollbar-color: $primary 30%;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $surface;
}

/* ---------- ChatMessage (base + variantes) ---------- */
/* Sub-sprint TUI-CHATMESSAGE-WIDGET-01 emite ChatMessage(role=...) com
 * classes user/assistant/tool/system. Base define geometria; variantes
 * coloram e destacam border-left. */

ChatMessage {
    height: auto;
    background: $surface;
    padding: 0 1;
    margin: 0;
}

ChatMessage.user {
    /* TUI-CHAT-LABELS-COLORS-01: conteúdo neutro ($foreground); o nome leva a
       cor de destaque (turquesa) via span Rich no render(). border-left mantém
       a identidade da role. */
    color: $foreground;
    border-left: heavy $accent;
    padding: 0 1 0 2;
    margin: 1 0 0 0;
}

ChatMessage.assistant {
    /* TUI-CHAT-LABELS-COLORS-01: idem -- nome roxo via span, conteúdo neutro. */
    color: $foreground;
    border-left: heavy $primary;
    padding: 0 1 0 2;
    margin: 1 0 0 0;
}

ChatMessage.tool {
    color: $muted;
    padding: 0 1 0 4;
    margin: 0;
}

ChatMessage.system {
    color: $muted;
    text-style: italic;
    padding: 0 1;
    margin: 0;
}

/* ---------- Collapsible.thinking (TUI-THINKING-EXPAND-01) ---------- */
/* Bloco de raciocínio do modelo, recolhido por padrão. Cor muted (auxiliar,
 * secundário à conversa); o expand/collapse é nativo do Textual. */
Collapsible.thinking {
    color: $muted;
    margin: 1 0 0 0;
}

/* ---------- Static.thinking-live (TUI-THINKING-LIVE-01, ONDA-37) ---------- */
/* Indicador efêmero "pensando... (Ns)" durante a inferência. Mesma moldura do
 * balão do assistant (border-left roxo) -- parece a Nyx em progresso; removido
 * quando o 1º token chega ou no fim do turno. */
Static.thinking-live {
    color: $muted;
    border-left: heavy $primary;
    padding: 0 1 0 2;
    margin: 1 0 0 0;
}

/* ---------- #bottombar: container do input + toolbar (TUI-INPUT-HEIGHT-5-SCROLL-01) ---------- */
/* SPRINT 306: agrupa InputWidget (h:7) e Toolbar (h:1) num unico container
 * dock:bottom. Dois dock:bottom SOLTOS nao reservavam o espaco somado -- o
 * #chat (1fr) descontava so o input e a toolbar caia sobre a borda inferior do
 * input (o "corte"). Com o container, o rodape reserva 8 linhas (height:auto =
 * soma dos filhos) e o #chat fica com o resto. */
#bottombar {
    dock: bottom;
    height: auto;
    background: $surface;
}

/* ---------- InputWidget (altura FIXA de 5 linhas; vive em #bottombar) ---------- */
/* SPRINT 286: base TextArea multiline (Ctrl+J insere nova linha).
 * TUI-INPUT-HEIGHT-5-SCROLL-01 (SPRINT 306): altura FIXA de 5 linhas de
 * conteudo. `border: round` consome 2 linhas (topo+base) e o box-model do
 * Textual inclui a borda em `height`, logo height = 5 + 2 = 7. Conteudo alem
 * de 5 linhas rola DENTRO do TextArea (scroll interno nativo da base
 * TextArea/ScrollView). O dock saiu daqui: o empilhamento e a reserva de
 * espaco sao responsabilidade do #bottombar (acima). */

InputWidget {
    height: 7;
    background: $surface;
    border: round $accent;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary 30%;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $accent;
}

/* Placeholder do TextArea (classe interna distinta do .input--placeholder). */
InputWidget > .text-area--placeholder {
    color: $accent 50%;
}

/* Ghost-completer do slash (sprint 284): sugestao dim na posicao do cursor.
 * Reerguido sobre o reactive `suggestion` nativo do TextArea; cor da paleta
 * Nyx (muted), sem hex hardcoded. */
InputWidget > .text-area--suggestion {
    color: $muted;
}

/* ---------- Toolbar (dock: bottom, altura 1) ---------- */
/* Paridade SHIFT-TAB-CYCLE-01 + bottom_toolbar do prompt_toolkit.
 * Cor muted base; modos (normal/plan/sudo/bypass) sobrescrevem por
 * classe inline (Toolbar.-plan, Toolbar.-sudo, Toolbar.-bypass) via
 * watch_mode handler do widget. */

Toolbar {
    height: 1;
    background: $surface;
    color: $muted;
    padding: 0 1;
}

Toolbar.-plan {
    color: $primary;
}

Toolbar.-sudo {
    color: $error;
}

Toolbar.-bypass {
    color: $primary;
    text-style: dim;
}

/* ---------- Utility classes (paridade Luna) ---------- */
/* Classes reutilizaveis para realce textual; aplicadas via add_class()
 * a partir de widgets de ChatMessage. */

.dim {
    color: $muted;
}

.muted {
    color: $muted;
    text-style: dim;
}

.accent {
    color: $accent;
}

.primary {
    color: $primary;
}

.success {
    color: $success;
}

.error {
    color: $error;
    text-style: bold;
}

.italic {
    text-style: italic;
}
